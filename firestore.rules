rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows anyone with your Firestore database reference to view, edit,
    // and delete all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules

    // collectiop 'users': thông tin cá nhân của từng người 
    match /users/{user_id} {    
      // cho phép đọc và tạo mới nếu đã xác minh người dùng
      allow read, create: if request.auth != null;  
      // cho phép sửa nếu id documents trung với id user (chỉ cá nhân tự sửa)
      allow update: if request.auth.uid == user_id;
    }

    // collectiop 'Projects': thông tin tất cả dự án
    match /projects/{project_id} {
      // cho phép đọc, ghi, tạo mới nếu đã xác minh người dùng
      allow read, create, update: if request.auth != null;
      // cho phép xóa nếu documents được tạo bởi đúng user
      allow delete: if request.auth.uid == resource.data.createdBy.id;
    }
  }
}